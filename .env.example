# ========================================
# RAG System Environment Variables
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control

# ========================================
# OpenAI Configuration
# ========================================
# Required for embeddings and LLM synthesis
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model selection for embeddings (default: text-embedding-3-small)
EMBED_MODEL=text-embedding-3-small

# Model selection for response synthesis (default: gpt-4-turbo-preview)
SYNTHESIS_MODEL=gpt-4-turbo-preview

# ========================================
# Google Sheets Configuration
# ========================================
# The ID of your Google Spreadsheet containing the data
# Found in the URL: https://docs.google.com/spreadsheets/d/[SPREADSHEET_ID]/edit
SPREADSHEET_ID=your-spreadsheet-id-here

# Google Service Account Credentials
# For Vercel/Production: Use single-line JSON format
# Example: GOOGLE_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key":"..."}'
GOOGLE_CREDENTIALS_JSON=

# For Local Development: Use file path
# Download your service account JSON file and reference it here
GOOGLE_APPLICATION_CREDENTIALS=google-credentials.json

# ========================================
# Vercel Blob Storage Configuration
# ========================================
# Required for persistent Index Pack storage
# Get this from your Vercel dashboard: Project Settings > Storage > Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_your_token_here

# Prefix for Index Pack storage in Blob (default: rag-packs/)
# Must end with a forward slash
INDEX_PACK_PREFIX=rag-packs/

# ========================================
# Cache & Performance Configuration
# ========================================
# TTL for in-memory Index Pack cache in seconds (default: 300 = 5 minutes)
INDEX_PACK_TTL=300

# Threshold for strong heuristic matches to skip LLM (0.0-1.0, default: 0.75)
# Higher values = more LLM usage, better quality
# Lower values = less LLM usage, faster responses
HEURISTIC_STRONG_T=0.75

# Threshold for exact match confidence (0.0-1.0, default: 0.85)
EXACT_MATCH_THRESHOLD=0.85

# ========================================
# Admin & Security Configuration
# ========================================
# Token for accessing diagnostic endpoints (/api/blob-selftest, /api/pack-selftest)
# Use a strong, random token in production
ADMIN_TOKEN=your-admin-token-here

# Session secret for cookie signing (if using sessions)
SESSION_SECRET=your-session-secret-here

# Admin password for protected routes (if applicable)
ADMIN_PASSWORD=your-admin-password-here

# ========================================
# Server Configuration
# ========================================
# Port for local development (default: 8009)
PORT=8009

# Node environment (development, production, test)
NODE_ENV=development

# Enable debug logging (true/false)
DEBUG=false

# ========================================
# Data Source Configuration (Future)
# ========================================
# Switch between data sources (GOOGLE_SHEET or ONEDRIVE)
DATA_SOURCE=GOOGLE_SHEET

# OneDrive URL (if using OneDrive as data source)
ONEDRIVE_URL=

# ========================================
# IMPORTANT SECURITY NOTES
# ========================================
# 1. NEVER commit .env file with real credentials
# 2. NEVER log or expose tokens in client code
# 3. Use environment-specific .env files (.env.local, .env.production)
# 4. Rotate tokens regularly
# 5. Use strong, unique values for all secrets and tokens

# ========================================
# Vercel Deployment Instructions
# ========================================
# 1. Go to your Vercel project dashboard
# 2. Navigate to Settings > Environment Variables
# 3. Add each variable from this file (except file paths)
# 4. For GOOGLE_CREDENTIALS_JSON:
#    - Convert your service account JSON to single-line format
#    - Or use base64 encoding if the JSON is too complex
# 5. Redeploy your project after adding variables

# ========================================
# Testing Checklist
# ========================================
# After setting up environment variables:
# 1. Run: curl -X POST http://localhost:8009/api/blob-selftest?admin_token=YOUR_TOKEN
# 2. Run: curl -X POST http://localhost:8009/api/pack-selftest?admin_token=YOUR_TOKEN
# 3. Run: curl -X POST http://localhost:8009/api/refresh?dryRun=true
# 4. Run: curl -X POST http://localhost:8009/api/refresh
# 5. Test search: curl -X POST http://localhost:8009/api/recommend -H "Content-Type: application/json" -d '{"query":"קו 18 לרמות"}'
# 6. Check status: curl http://localhost:8009/api/status